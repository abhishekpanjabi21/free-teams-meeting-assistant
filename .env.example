# Copy this file to ".env" (same folder) and fill in your values.
# .env is private: it stays on your Mac and is never sent to the browser.

# Your name, used instead of "You" in transcripts and minutes (recommended)
MY_NAME=

# Transcription language: en (English), hi (Hindi) or auto
WHISPER_LANGUAGE=en

# Optional, paid: Claude API key from https://console.anthropic.com (starts with sk-ant-)
# Leave empty to use the free copy-paste mode with Claude or Gemini.
ANTHROPIC_API_KEY=

# Optional: which Claude model the API uses
CLAUDE_MODEL=claude-sonnet-5-5

# Optional: change the port if 3000 is busy
PORT=3000
